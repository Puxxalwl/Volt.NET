<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Volt.Cli</RootNamespace>
    <AssemblyName>volt</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>volt</ToolCommandName>
    <PackageId>Volt.Cli</PackageId>
    <PackageTags>web;framework;ssg;cli;tool</PackageTags>
    <Description>Volt.NET CLI: `volt new` scaffolding, dev server, AOT build, export, `volt wasm validate`. Install: dotnet tool install --global Volt.Cli</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Volt.Core\Volt.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Template files for `volt new`; keep the tree in sync with examples/starter -->
    <EmbeddedResource Include="templates/app/**/*.cs" />
    <EmbeddedResource Include="templates/app/**/*.csproj" />
    <EmbeddedResource Include="templates/app/**/*.css" />
    <EmbeddedResource Include="templates/app/**/*.md" />
  </ItemGroup>
</Project>
