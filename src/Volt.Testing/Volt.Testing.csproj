<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>Volt.Testing</PackageId>
    <IsPublishable>true</IsPublishable>
    <Description>Volt.NET testing utilities: in-process test server (no sockets) + HTML golden-file snapshot assertions for pages.</Description>
    <!-- a LIBRARY referencing xunit — never a test project itself (dotnet test must skip it) -->
    <IsTestProject>false</IsTestProject>
    <RootNamespace>Volt.Testing</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Volt.Core\Volt.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
  </ItemGroup>
</Project>
